{
  "name": "brawler",
  "private": true,
  "version": "0.61.5",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "stylelint": "stylelint \"src/**/*.css\"",
    "knip": "knip && node scripts/check/api-surface-guard.mjs",
    "test": "vitest run src",
    "test:browser:install": "playwright install chromium",
    "test:browser": "playwright test",
    "test:browser:screens": "playwright test fundamentals-ai",
    "test:watch": "vitest",
    "release:commit-msg-check": "scripts/release/check-commit-message-validator.sh",
    "release:version-check": "scripts/release/check-version-sync.sh",
    "release:changelog-check": "git-cliff --config cliff.toml --strip header HEAD..HEAD",
    "check:frontend": "npm run typecheck && npm run lint && npm run stylelint && npm run test && npm run build",
    "check:rust": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo nextest run && cargo test --doc",
    "check": "npm run check:frontend && npm run check:rust",
    "check:parallel": "node scripts/check/parallel-check.mjs",
    "test:coverage": "vitest run src --coverage",
    "coverage:ratchet": "node scripts/check/coverage-ratchet.mjs",
    "bench:ratchet": "node scripts/check/bench-ratchet.mjs",
    "report:escaped-defects": "node scripts/ux/escaped-defects-report.mjs",
    "ux-contact-sheet": "node scripts/ux/contact-sheet.mjs",
    "visual-update": "node scripts/ux/visual-update-guard.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "dockview": "^6.6.1",
    "lucide-react": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^24.1.1",
    "knip": "^6.29.0",
    "stylelint": "^17.14.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  }
}
