      {
        "description": "Compute the level-1 comparative valuation for one company (peer-multiple implied fair-value ranges for P/E, EV/EBITDA, and P/BV, method-convergence spread, and a deterministic confidence grade) and append a valuation_runs row per method whose input signature changed. Read the history via list_valuation_runs. Decision support only — never buy/sell/hold language.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "companyId": {
              "type": "string"
            }
          },
          "required": [
            "companyId"
          ],
          "type": "object"
        },
