---
source: src/mcp/protocol.rs
expression: "serde_json::to_string_pretty(&v).expect(\"serializable\")"
---
{
  "id": 1,
  "jsonrpc": "2.0",
  "result": {
    "tools": [
      {
        "description": "Start or resume a KPI ingest run (ADR 0099). Fresh: documentId + profileId (+ optional scope/dataQuality/period) creates the run, claims the lease, pins the source bytes, and enters extraction once context is complete. Resume: runId re-claims idempotently (the explicit keepalive) and attaches missing context set-once. Provenance is the run pipeline itself; no citation carrier here.",
        "inputSchema": {
          "additionalProperties": false,
          "definitions": {
            "RunDataQualityInput": {
              "enum": [
                "final",
                "preliminary",
                "estimated"
              ],
              "type": "string"
            },
            "RunScopeInput": {
              "enum": [
                "standalone",
                "consolidated"
              ],
              "type": "string"
            },
            "StartPeriodInput": {
              "additionalProperties": false,
              "properties": {
                "fiscalYear": {
                  "format": "int64",
                  "type": "integer"
                },
                "periodType": {
                  "$ref": "#/definitions/StartPeriodType"
                }
              },
              "required": [
                "fiscalYear",
                "periodType"
              ],
              "type": "object"
            },
            "StartPeriodType": {
              "description": "The START period vocabulary (contracts.md § KPI acquisition workflow tools): `Q1|H1|9M|FY` only — the validator refuses everything else via `run.unsupported_period_grammar`, so a run doomed to fail cannot start. The schema IS the enforcement.",
              "enum": [
                "Q1",
                "H1",
                "9M",
                "FY"
              ],
              "type": "string"
            }
          },
          "properties": {
            "dataQuality": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RunDataQualityInput"
                },
                {
                  "type": "null"
                }
              ]
            },
            "documentId": {
              "type": "string"
            },
            "period": {
              "anyOf": [
                {
                  "$ref": "#/definitions/StartPeriodInput"
                },
                {
                  "type": "null"
                }
              ]
            },
            "profileId": {
              "type": "string"
            },
            "runId": {
              "type": "string"
            },
            "scope": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RunScopeInput"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        "name": "start_kpi_ingest"
      },
      {
        "description": "List claimable KPI ingest runs (discovered/source_captured/extracting/validation_failed), newest first, keyset-paginated (limit ≤ 50, default 20).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "companyId": {
              "type": "string"
            },
            "cursor": {
              "type": "string"
            },
            "limit": {
              "format": "int64",
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "name": "list_pending_kpi_ingests"
      },
      {
        "description": "Everything one report's extraction needs, within hard budgets (≤256 KiB): run status, document metadata, the derived-period hint, the expected+minted KPI catalog, validator-equivalent plausibility evidence per slot, profile doctrine and repair-manifest access. Sections (catalog/plausibility/manifest) paginate via cursors; the manifest is served only via section calls. Pure read.",
        "inputSchema": {
          "additionalProperties": false,
          "definitions": {
            "ContextSection": {
              "enum": [
                "catalog",
                "plausibility",
                "manifest"
              ],
              "type": "string"
            }
          },
          "properties": {
            "cursor": {
              "description": "Continuation cursor from a previous truncated response (section calls only).",
              "type": "string"
            },
            "limit": {
              "description": "Page size for a section call (≤ the section's cap; default = the cap).",
              "format": "int64",
              "type": "integer"
            },
            "runId": {
              "type": "string"
            },
            "section": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ContextSection"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Omit for the full default context; name a section to paginate it."
            }
          },
          "required": [
            "runId"
          ],
          "type": "object"
        },
        "name": "get_kpi_ingest_context"
      },
      {
        "description": "Chunked bytes (offset/length ≤ 256 KiB, base64) from the run's content-addressed source blob, verified against the frozen sourceContentHash — the portable document delivery channel. Available once the source is captured. Pure read.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "length": {
              "format": "uint64",
              "maximum": 262144,
              "minimum": 1,
              "type": "integer"
            },
            "offset": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "runId": {
              "type": "string"
            }
          },
          "required": [
            "length",
            "offset",
            "runId"
          ],
          "type": "object"
        },
        "name": "get_kpi_ingest_document"
      },
      {
        "description": "Stage the COMPLETE revision snapshot of extracted observations (1..100, with citations) plus the REQUIRED missingReasons declaration ({} = explicitly none), written in the same transaction. A repair resends every retained observation. Requires the caller's live lease. Provenance is the run pipeline itself.",
        "inputSchema": {
          "additionalProperties": false,
          "definitions": {
            "AttributionInput": {
              "enum": [
                "total",
                "owners_of_parent",
                "nci"
              ],
              "type": "string"
            },
            "CitationInput": {
              "additionalProperties": false,
              "properties": {
                "page": {
                  "format": "int64",
                  "minimum": 1,
                  "type": "integer"
                },
                "quote": {
                  "type": "string"
                },
                "row": {
                  "type": "string"
                },
                "table": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "ExecutionMetaInput": {
              "additionalProperties": false,
              "description": "`ExecutionMeta` (contracts.md shared shapes): diagnostic agent metadata. `client` is REQUIRED in every supplied payload; numerics are totals / snapshots, never deltas. Optional fields are skipped when absent so the stored merge never overwrites a field with `null`.",
              "properties": {
                "client": {
                  "type": "string"
                },
                "costUsd": {
                  "format": "double",
                  "minimum": 0.0,
                  "type": "number"
                },
                "model": {
                  "type": "string"
                },
                "repairRounds": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "skillVersion": {
                  "type": "string"
                },
                "tokensIn": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "tokensOut": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "client"
              ],
              "type": "object"
            },
            "MappingStatusInput": {
              "oneOf": [
                {
                  "enum": [
                    "unmapped",
                    "mapped",
                    "no_definition"
                  ],
                  "type": "string"
                },
                {
                  "const": "excluded",
                  "description": "A deliberate, reasoned exclusion (ADR 0102 dec. 1) — legal only alongside a non-blank `exclusionReason`.",
                  "type": "string"
                }
              ]
            },
            "MeasureWindowInput": {
              "enum": [
                "flow",
                "point_in_time",
                "trailing",
                "cumulative",
                "duration"
              ],
              "type": "string"
            },
            "ObservationInput": {
              "additionalProperties": false,
              "description": "One staged observation exactly as the tool contract freezes it (contracts.md tool 5). Raw fields are stored verbatim; normalized fields are the agent's own normalization for audit.",
              "properties": {
                "attribution": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/AttributionInput"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "citation": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/CitationInput"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "type": "string"
                },
                "exclusionReason": {
                  "description": "Required exactly when `mappingStatus == \"excluded\"` (ADR 0102 dec. 1); a reason on any other disposition is a typed refusal.",
                  "type": "string"
                },
                "mappingStatus": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/MappingStatusInput"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "measureWindow": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/MeasureWindowInput"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "metricKeyCandidate": {
                  "type": "string"
                },
                "normalizedValue": {
                  "type": "string"
                },
                "rawCurrency": {
                  "type": "string"
                },
                "rawLabel": {
                  "type": "string"
                },
                "rawUnitScale": {
                  "type": "string"
                },
                "rawValue": {
                  "type": "string"
                },
                "scope": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/RunScopeInput"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unitScale": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/UnitScaleInput"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "rawLabel",
                "rawValue"
              ],
              "type": "object"
            },
            "RunScopeInput": {
              "enum": [
                "standalone",
                "consolidated"
              ],
              "type": "string"
            },
            "UnitScaleInput": {
              "enum": [
                "ones",
                "thousands",
                "millions"
              ],
              "type": "string"
            }
          },
          "properties": {
            "execution": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ExecutionMetaInput"
                },
                {
                  "type": "null"
                }
              ]
            },
            "missingReasons": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "REQUIRED: `{}` is the explicit \"no declared omissions\"/clear — there is no destructive default (contracts.md tool 5).",
              "type": "object"
            },
            "observations": {
              "items": {
                "$ref": "#/definitions/ObservationInput"
              },
              "type": "array"
            },
            "runId": {
              "type": "string"
            }
          },
          "required": [
            "missingReasons",
            "observations",
            "runId"
          ],
          "type": "object"
        },
        "name": "stage_kpi_observations"
      },
      {
        "description": "Mint (or reuse) a company-scoped, origin=agent KPI catalog entry for a disclosed number the canon has no key for (ADR 0101). Guard order: this company's own minted entry is returned as-is (created: false); a curated kpi_aliases synonym refuses with a typed synonym_redirect naming the canonical key and definitionId; an exact shared-canon key returns the canonical definition (created: false, never a company shadow); only a genuinely new key mints — never fuzzy matching. Page the full catalog (get_kpi_ingest_context) before proposing. Requires the caller's live lease.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "metricKey": {
              "type": "string"
            },
            "runId": {
              "type": "string"
            },
            "statementGroup": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "metricKey",
            "runId",
            "statementGroup"
          ],
          "type": "object"
        },
        "name": "propose_kpi_definition"
      },
      {
        "description": "Validate one staged revision synchronously (generation-pinned). Returns the FULL manifest — a failed manifest is the typed repair report; a raced loser gets outcome=superseded with the current run tuple.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "revision": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            },
            "runId": {
              "type": "string"
            }
          },
          "required": [
            "revision",
            "runId"
          ],
          "type": "object"
        },
        "name": "validate_kpi_ingest"
      },
      {
        "description": "Atomically commit a ready manifest (runId + manifestHash + revision) and return the immutable receipt. Idempotent: replaying a committed tuple returns the stored receipt verbatim; a stale tuple is a typed conflict.",
        "inputSchema": {
          "additionalProperties": false,
          "definitions": {
            "ExecutionMetaInput": {
              "additionalProperties": false,
              "description": "`ExecutionMeta` (contracts.md shared shapes): diagnostic agent metadata. `client` is REQUIRED in every supplied payload; numerics are totals / snapshots, never deltas. Optional fields are skipped when absent so the stored merge never overwrites a field with `null`.",
              "properties": {
                "client": {
                  "type": "string"
                },
                "costUsd": {
                  "format": "double",
                  "minimum": 0.0,
                  "type": "number"
                },
                "model": {
                  "type": "string"
                },
                "repairRounds": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "skillVersion": {
                  "type": "string"
                },
                "tokensIn": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "tokensOut": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "client"
              ],
              "type": "object"
            }
          },
          "properties": {
            "execution": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ExecutionMetaInput"
                },
                {
                  "type": "null"
                }
              ]
            },
            "manifestHash": {
              "type": "string"
            },
            "revision": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            },
            "runId": {
              "type": "string"
            }
          },
          "required": [
            "manifestHash",
            "revision",
            "runId"
          ],
          "type": "object"
        },
        "name": "commit_kpi_ingest"
      },
      {
        "description": "Full status of one KPI ingest run (state, context, lease, expected KPIs, progress). Pure read — never touches the lease.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string"
            }
          },
          "required": [
            "runId"
          ],
          "type": "object"
        },
        "name": "get_kpi_ingest_status"
      },
      {
        "description": "Cancel a KPI ingest run in any pre-commit state (releases its lease). Refuses `committing` and terminal states.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string"
            }
          },
          "required": [
            "runId"
          ],
          "type": "object"
        },
        "name": "cancel_kpi_ingest"
      }
    ]
  }
}
