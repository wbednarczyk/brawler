#!/usr/bin/env bash
set -euo pipefail

# Cheap redundant layout-overflow re-check on every push (ADR 0045 guardrail).
# The full Playwright browser suite is now a hard-fail step of the per-commit
# `make check` (ADR 0062), so commits are already gated; this is belt-and-
# suspenders. It runs the fast, data-driven `smoke-walk` spec (it walks the actual
# rendered sidebar destinations across the viewport matrix, incl. the tall/narrow
# quarter-ultrawide windows) so a nav/landing/layout change that reintroduces
# horizontal overflow FAILS the push even behind a `--no-verify` commit.
#
# Scope is deliberately the smoke-walk only — it is fast (~10-20s). The full
# browser suite runs in `make check` / `make ui-smoke`. Installed via
# `make install-git-hooks` (sets core.hooksPath to .githooks).

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

printf '▶ pre-push: layout-overflow smoke-walk (Playwright)…\n'

if ! npx --no-install playwright --version >/dev/null 2>&1; then
  printf '⚠ pre-push: Playwright not installed — run `make ui-smoke` once. Skipping the smoke-walk gate.\n'
  exit 0
fi

# Reuses any running vite dev server (playwright.config webServer). Runs the
# whole viewport matrix for just the smoke-walk spec.
npm run test:browser -- smoke-walk.spec.ts
