#!/usr/bin/env bash
set -euo pipefail

# Fast layout-overflow gate on every push (ADR 0045 guardrail). The Playwright
# browser suite is otherwise only run — non-gating — at epic closure
# (`make check-epic`'s `-`-prefixed `test:browser`), which let it rot silently
# red across two sessions. This runs the cheap, data-driven `smoke-walk` spec
# (it walks the actual rendered sidebar destinations across the viewport matrix,
# incl. the tall/narrow quarter-ultrawide windows) so a nav/landing/layout change
# that reintroduces horizontal overflow FAILS the push instead of a later triage.
#
# Scope is deliberately the smoke-walk only — it is fast (~10-20s) so the gate is
# never tempting to `--no-verify` past. The full browser suite stays at
# `make ui-smoke` / `make check-epic`. Installed via `make install-git-hooks`
# (sets core.hooksPath to .githooks).

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

printf '▶ pre-push: layout-overflow smoke-walk (Playwright)…\n'

if ! npx --no-install playwright --version >/dev/null 2>&1; then
  printf '⚠ pre-push: Playwright not installed — run `make ui-smoke` once. Skipping the smoke-walk gate.\n'
  exit 0
fi

# Reuses any running vite dev server (playwright.config webServer). Runs the
# whole viewport matrix for just the smoke-walk spec.
npm run test:browser -- smoke-walk.spec.ts
