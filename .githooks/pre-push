#!/usr/bin/env bash
set -euo pipefail

# Pre-push gate (ADR 0062, amended 2026-07-15). The heavy gate lives here, not on
# every commit: pushing `master` runs the FULL `make check` (all deterministic
# suites incl. the Playwright viewport matrix, under Nix). This is the boundary
# where code becomes shared, and there is NO CI mirror of `make check`, so this
# local hook is the hard guarantee that master is never advanced past a red gate.
# Per-commit checkpoints run only the fast core (`make check-fast`, see
# .githooks/pre-commit); the browser matrix is paid once, here, at push.
#
# Non-master pushes (feature branches) keep the cheap layout-overflow smoke-walk
# only (ADR 0045) — fast belt-and-suspenders, not the full matrix.
#
# Escape hatch: `BRAWLER_GATE_ALREADY_GREEN=1` skips the full check on a master
# push. It exists for `make release`, which runs `make check` itself immediately
# before pushing — re-running it in the hook would gate the identical tree twice.
# This is a caller vouching it already ran the gate, NOT a way to weaken it: a
# plain `git push` (no env var) always gets the full gate.
#
# Installed via `make install-git-hooks` (sets core.hooksPath to .githooks).

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Detect whether any ref being pushed targets master. Git feeds the hook one
# line per ref on stdin: "<local ref> <local sha> <remote ref> <remote sha>".
pushing_master=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  case "$remote_ref" in
    refs/heads/master) pushing_master=1 ;;
  esac
done

if [ "$pushing_master" -eq 1 ]; then
  if [ "${BRAWLER_GATE_ALREADY_GREEN:-}" = "1" ]; then
    printf '▶ pre-push: master push with BRAWLER_GATE_ALREADY_GREEN=1 — caller already ran make check; skipping the redundant full gate.\n'
    exit 0
  fi
  if ! command -v make >/dev/null 2>&1 || ! command -v nix >/dev/null 2>&1; then
    printf '✖ pre-push: `make`/`nix` not found — the master gate runs the full `make check` under Nix. Install the toolchain, then retry.\n' >&2
    exit 1
  fi
  printf '▶ pre-push: master push — running the FULL mandatory gate (make check) under Nix…\n'
  make check
  printf '✓ pre-push: full gate green — advancing master.\n'
  exit 0
fi

# Non-master push: the cheap layout-overflow smoke-walk (ADR 0045 guardrail).
# Reuses any running vite dev server (playwright.config webServer).
printf '▶ pre-push: layout-overflow smoke-walk (Playwright)…\n'
if ! npx --no-install playwright --version >/dev/null 2>&1; then
  printf '⚠ pre-push: Playwright not installed — run `make ui-smoke` once. Skipping the smoke-walk gate.\n'
  exit 0
fi
npm run test:browser -- smoke-walk.spec.ts
