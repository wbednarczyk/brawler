#!/usr/bin/env bash
set -euo pipefail

# Pre-commit gate (ADR 0062, amended 2026-07-15). The gate is split by git phase
# so every commit stays cheap while master still never receives un-gated code:
#   - pre-commit (here): the FAST core — `make check-fast` (typecheck, lint,
#     stylelint, Rust nextest, frontend vitest, build; parallel, NO browser
#     matrix). ~2-4 min. Catches the overwhelming majority of breaks at commit
#     time without the ~15-min Playwright viewport matrix on every checkpoint.
#   - pre-push (.githooks/pre-push): the FULL `make check` (incl. the browser
#     matrix) fires ONLY when the push targets `master` — the boundary where
#     code becomes shared. There is no CI mirror of `make check`, so this local
#     pre-push gate is the hard guarantee that master is always fully green.
# Owner decision 2026-07-15: "gate tylko przy mergu do mastera" — per-commit
# full runs were too costly. A docs-only changeset still runs only check-docs.
#
# Fail-not-skip: a missing tool here is a FAILURE with a fix instruction — a
# silent skip is exactly the hole that lets a suite rot.
#
# `git commit --no-verify` exists for genuine WIP/emergency commits, but per
# AGENTS.md a hand-back or "done" claim is never valid on a --no-verify commit.
# Installed via `make install-git-hooks` (sets core.hooksPath to .githooks).

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v make >/dev/null 2>&1; then
  printf '✖ pre-commit: `make` not found — cannot run the gate. Install build tools, then retry.\n' >&2
  exit 1
fi
if ! command -v nix >/dev/null 2>&1; then
  printf '✖ pre-commit: `nix` not found — the gate runs under `nix develop`. Install Nix (see docs/engineering-workflow.md), then retry.\n' >&2
  exit 1
fi

# Scope the gate to what changed (ADR 0062, 2026-07-13): a DOCS-ONLY changeset
# cannot alter code behavior, so it runs only the doc meta-guards (mandatory-read
# byte budgets + parity via gate-integrity, and docs drift) — not the full code
# suite. ANY non-doc file → the full gate. A doc is `docs/**`, `wiki/**`, or any
# `*.md`; everything else (src, tests, scripts, config, Makefile, .githooks,
# Cargo/package manifests) is code and gets the whole gate.
# diff-filter includes D: a commit that DELETES a code file must run the full
# gate — a deletion breaks builds/tests exactly like an edit (review 2026-07-14).
staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
docs_only=1
[ -z "$staged" ] && docs_only=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    docs/*|wiki/*|*.md) ;;
    *) docs_only=0 ;;
  esac
done <<STAGED
$staged
STAGED

if [ "$docs_only" -eq 1 ]; then
  printf '▶ pre-commit: docs-only changeset — running the doc meta-guards (make check-docs)…\n'
  make check-docs
  printf '✓ pre-commit: doc meta-guards green — creating the commit.\n'
else
  printf '▶ pre-commit: running the fast core gate (make check-fast) under Nix — the full browser matrix runs at push-to-master…\n'
  make check-fast
  printf '✓ pre-commit: fast core gate green — creating the commit.\n'
fi
